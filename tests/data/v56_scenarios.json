        "WF-005"
      ],
      "rationale": "Literal authored development oracle; not model output and not a holdout.",
      "assumptions": [],
      "steps": [
        {
          "action": "submit",
          "actor": "customer-m100",
          "data": {
            "claim_id": "SURV-561",
            "member_id": "M100",
            "service": "medical",
            "amount_cents": 112345
          },
          "expect": {
            "status": 201,
            "claim_status": "submitted",
            "revision": 1,
            "event_count": 1,
            "payout_cents": 102345,
            "payment_cents": null
          }
        },
        {
          "action": "read",
          "actor": "customer-m200",
          "data": {
            "claim_id": "SURV-561"
          },
          "expect": {
            "status": 403,
            "error": "FORBIDDEN"
          }
        },
        {
          "action": "submit",
          "actor": "customer-m100",
          "data": {
            "claim_id": "SURV-561",
            "member_id": "M100",
            "service": "medical",
            "amount_cents": 112345
          },
          "expect": {
            "status": 409,
            "error": "DUPLICATE_CLAIM"
          }
        },
        {
          "action": "read",
          "actor": "customer-m100",
          "data": {
            "claim_id": "SURV-561"
          },
          "expect": {
            "status": 200,
            "claim_status": "submitted",
            "revision": 1,
            "event_count": 1,
            "payout_cents": 102345,
            "payment_cents": null
          }
        },
        {
          "action": "transition",
          "actor": "finance-demo",
          "data": {
            "claim_id": "SURV-561",
            "target": "paid"
          },
          "expect": {
            "status": 409,
            "error": "INVALID_TRANSITION"
          }
        },
        {
          "action": "read",
          "actor": "customer-m100",
          "data": {
            "claim_id": "SURV-561"
          },
          "expect": {
            "status": 200,
            "claim_status": "submitted",
            "revision": 1,
            "event_count": 1,
            "payout_cents": 102345,
            "payment_cents": null
          }
        },
        {
          "action": "transition",
          "actor": "adjuster-demo",
          "data": {
            "claim_id": "SURV-561",
            "target": "approved"
          },
          "expect": {
            "status": 200,
            "claim_status": "approved",
            "revision": 2,
            "event_count": 2,
            "payout_cents": 102345,
            "payment_cents": null
          }
        },
        {
          "action": "transition",
          "actor": "finance-demo",
          "data": {
            "claim_id": "SURV-561",
            "target": "paid"
          },
          "expect": {
            "status": 200,
            "claim_status": "paid",
            "revision": 3,
            "event_count": 3,
            "payout_cents": 102345,
            "payment_cents": 102345
          }
        }
      ]
    },
