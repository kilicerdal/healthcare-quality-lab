        "id": "BN-002",
        "contract": "Adjudicate each line against the chosen synthetic plan service, network, authorization and formulary facts; retain partial denials."
      },
      {
        "id": "BN-003",
        "contract": "Apply other-payer payment first; it cannot exceed the line allowed amount."
      },
      {
        "id": "BN-004",
        "contract": "Apply remaining member/family deductible, nominal copay, then floor payer coinsurance; cap actual member charge at member/family OOP and payout at remaining annual benefit. Benefit excess is noncovered, not OOP."
      },
      {
        "id": "BN-005",
        "contract": "Reserve allocations at adjudication by service year. Credits reverse only that claim allocation; later claims are not repriced. Family F100 has three members so embedded caps can bind."
      },
