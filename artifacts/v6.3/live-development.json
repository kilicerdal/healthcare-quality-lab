services\": [\"hospital\", \"medical\", \"outpatient\", \"prescription\", \"preventive\", \"mental_health\", \"maternity\", \"rehabilitation\", \"emergency\", \"lab\"]}, \"dental\": {\"authorization_services\": [], \"deductible_cents\": 10000, \"description\": \"Routine dental service fixture\", \"family\": \"Supplemental\", \"id\": \"dental\", \"limit_cents\": 200000, \"name\": \"Standalone dental\", \"network_required\": true, \"services\": [\"dental\"]}, \"medicare_a\": {\"authorization_services\": [\"skilled_nursing\"], \"deductible_cents\": 10000, \"description\": \"Hospital and facility services\", \"family\": \"Medicare\", \"id\": \"medicare_a\", \"limit_cents\": 200000, \"name\": \"Medicare Part A\", \"network_required\": false, \"services\": [\"hospital\", \"skilled_nursing\", \"hospice\", \"home_health\"]}, \"medicare_advantage\": {\"authorization_services\": [\"hospital\", \"dme\"], \"deductible_cents\": 10000, \"description\": \"A synthetic bundled HMO with extra benefits\", \"family\": \"Medicare\", \"id\": \"medicare_advantage\", \"limit_cents\": 200000, \"name\": \"Medicare Advantage / Part C\", \"network_required\": true, \"services\": [\"hospital\", \"medical\", \"outpatient\", \"preventive\", \"dme\", \"prescription\", \"dental\", \"vision\", \"hearing\", \"mental_health\", \"lab\"]}, \"medicare_b\": {\"authorization_services\": [], \"deductible_cents\": 10000, \"description\": \"Medical and outpatient services\", \"family\": \"Medicare\", \"id\": \"medicare_b\", \"limit_cents\": 200000, \"name\": \"Medicare Part B\", \"network_required\": false, \"services\": [\"medical\", \"outpatient\", \"preventive\", \"dme\", \"mental_health\", \"lab\", \"home_health\"]}, \"medicare_d\": {\"authorization_services\": [], \"deductible_cents\": 10000, \"description\": \"A synthetic prescription drug plan\", \"family\": \"Medicare\", \"id\": \"medicare_d\", \"limit_cents\": 200000, \"name\": \"Medicare Part D\", \"network_required\": true, \"services\": [\"prescription\"]}, \"vision\": {\"authorization_services\": [], \"deductible_cents\": 10000, \"description\": \"Routine vision service fixture\", \"family\": \"Supplemental\", \"id\": \"vision\", \"limit_cents\": 200000, \"name\": \"Standalone vision\", \"network_required\": true, \"services\": [\"vision\"]}}, \"rules\": {\"policies\": [{\"annual_benefit\": 200000, \"copay\": 1000, \"end\": \"2026-07-01\", \"family_deductible\": 20000, \"family_oop\": 60000, \"id\": \"SYN-2026-H1\", \"individual_deductible\": 10000, \"individual_oop\": 30000, \"payer_bps\": 8000, \"start\": \"2026-01-01\"}, {\"annual_benefit\": 200000, \"copay\": 1500, \"end\": \"2027-01-01\", \"family_deductible\": 20000, \"family_oop\": 60000, \"id\": \"SYN-2026-H2\", \"individual_deductible\": 10000, \"individual_oop\": 30000, \"payer_bps\": 8000, \"start\": \"2026-07-01\"}, {\"annual_benefit\": 220000, \"copay\": 1500, \"end\": \"2028-01-01\", \"family_deductible\": 24000, \"family_oop\": 64000, \"id\": \"SYN-2027\", \"individual_deductible\": 12000, \"individual_oop\": 32000, \"payer_bps\": 7500, \"start\": \"2027-01-01\"}], \"rules\": [{\"contract\": \"Canonical service date selects a half-open effective policy interval; only bounded integer cents and unique lines are accepted.\", \"id\": \"BN-001\"}, {\"contract\": \"Adjudicate each line against the chosen synthetic plan service, network, authorization and formulary facts; retain partial denials.\", \"id\": \"BN-002\"}, {\"contract\": \"Apply other-payer payment first; it cannot exceed the line allowed amount.\", \"id\": \"BN-003\"}, {\"contract\": \"Apply remaining member/family deductible, nominal copay, then floor payer coinsurance; cap actual member charge at member/family OOP and payout at remaining annual benefit. Benefit excess is noncovered, not OOP.\", \"id\": \"BN-004\"}, {\"contract\": \"Reserve allocations at adjudication by service year. Credits reverse only that claim allocation; later claims are not repriced. Family F100 has three members so embedded caps can bind.\", \"id\": \"BN-005\"}, {\"contract\": \"Finance pays or reverses once from the required state; idempotency keys bind actor/action/input and revisions serialize changes. Adjustments atomically credit old allocations and record debit/credit ledger entries.\", \"id\": \"BN-006\"}, {\"contract\": \"Owners may appeal adjudicated claims; adjusters resolve by reprocessing corrected lines under the same policy. Appeal resolution cannot invent coverage exceptions.\", \"id\": \"BN-007\"}], \"scope\": \"Invented rules for every plan, not actual Medicare or commercial policy. Quotes reserve allocated accumulators at adjudication. Reversal/adjustment credits only the original allocation; later claims are never repriced. Other-payer money is applied before deductible/copay. Benefit-cap excess is noncovered and does not increase OOP. Coinsurance uses floor integer cents. Policy dates are half-open intervals; accumulators reset by service calendar year.\", \"version\": \"synthetic-benefits-1\"}}",
