          },
          {
            "action": "transition",
            "actor": "finance-demo",
            "data": {
              "claim_id": "REF-1",
              "target": "paid"
            },
            "expect": {
              "status": 200,
              "claim_status": "paid",
              "revision": 3,
              "event_count": 3,
